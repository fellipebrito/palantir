<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required under the hardened runtime. Without it macOS refuses the camera
	     silently: no prompt, and the app never appears in Privacy > Camera, so
	     there is no switch to turn on. 1.0 and 1.0.1 shipped without it. -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
